<idea-plugin>
    <id>com.dzmitryj.LoreVersionControl</id>
    <name>LoreVersionControl</name>
    <dependencies>
        <plugin id="com.intellij.modules.vcs"/>
    </dependencies>

    <resource-bundle>messages.LoreBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <vcs name="Lore" vcsClass="com.dzmitryj.lorevcs.LoreVcs" displayName="Lore"
             administrativeAreaName=".lore" areChildrenValidMappings="true"/>
        <vcsRootChecker implementation="com.dzmitryj.lorevcs.repo.LoreRootChecker"/>
        <vfs.asyncListener implementation="com.dzmitryj.lorevcs.dirty.LoreAsyncFileListener"/>
        <postStartupActivity implementation="com.dzmitryj.lorevcs.dirty.LoreStartupRescan"/>
        <notificationGroup id="Lore" displayType="BALLOON" bundle="messages.LoreBundle" key="vcs.name"/>
        <editorNotificationProvider implementation="com.dzmitryj.lorevcs.lock.LoreLockBanner"/>
        <writingAccessProvider implementation="com.dzmitryj.lorevcs.lock.LoreWritingAccessProvider"/>
        <statusBarWidgetFactory id="LoreStatusBarWidget"
                                implementation="com.dzmitryj.lorevcs.ui.LoreStatusBarWidgetFactory"/>
        <checkoutProvider implementation="com.dzmitryj.lorevcs.update.LoreCheckoutProvider"/>
        <ignoredFileContentProvider implementation="com.dzmitryj.lorevcs.ignore.LoreIgnoredFileContentProvider"/>
        <fileType name="LoreIgnore file" language="LoreIgnore" fileNames=".loreignore" fieldName="INSTANCE"
                  implementationClass="com.dzmitryj.lorevcs.ignore.LoreIgnoreFileType"/>
        <lang.parserDefinition language="LoreIgnore"
                               implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreParserDefinition"/>
        <lang.braceMatcher language="LoreIgnore"
                           implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreBraceMatcher"/>
        <lang.commenter language="LoreIgnore"
                        implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreCommenter"/>
        <codeInsight.lineMarkerProvider language="LoreIgnore"
                                        implementationClass="com.intellij.openapi.vcs.changes.ignore.codeInsight.IgnoreDirectoryMarkerProvider"/>
        <changesViewContent id="LoreLog" tabName="Lore Log"
                            className="com.dzmitryj.lorevcs.ui.LoreLogTab"
                            predicateClassName="com.dzmitryj.lorevcs.ui.LoreLogTabVisibility"/>
    </extensions>

    <actions>
        <action id="Lore.FullRescan" class="com.dzmitryj.lorevcs.dirty.LoreFullRescanAction">
            <add-to-group group-id="Vcs.Operations.Popup.VcsAware" anchor="last"/>
        </action>
        <action id="Lore.CreateRepository" class="com.dzmitryj.lorevcs.update.LoreCreateRepositoryAction">
            <add-to-group group-id="Vcs.Import" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

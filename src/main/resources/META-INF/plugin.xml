<idea-plugin>
    <id>com.dzmitryj.lorelens</id>
    <name>LoreLens</name>
    <dependencies>
        <plugin id="com.intellij.modules.vcs"/>
    </dependencies>

    <resource-bundle>messages.LoreLensBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <vcs name="LoreLens" vcsClass="com.dzmitryj.lorelens.LoreVcs" displayName="LoreLens"
             administrativeAreaName=".lore" areChildrenValidMappings="true"/>
        <vcsRootChecker implementation="com.dzmitryj.lorelens.repo.LoreRootChecker"/>
        <vfs.asyncListener implementation="com.dzmitryj.lorelens.dirty.LoreAsyncFileListener"/>
        <editorFactoryListener implementation="com.dzmitryj.lorelens.blame.LoreBlameEditorListener"/>
        <postStartupActivity implementation="com.dzmitryj.lorelens.repo.LoreMappingMigration"/>
        <postStartupActivity implementation="com.dzmitryj.lorelens.ui.LoreWidgetAvailability"/>
        <postStartupActivity implementation="com.dzmitryj.lorelens.dirty.LoreStartupRescan"/>
        <notificationGroup id="LoreLens" displayType="BALLOON" bundle="messages.LoreLensBundle" key="vcs.name"/>
        <editorNotificationProvider implementation="com.dzmitryj.lorelens.lock.LoreLockBanner"/>
        <writingAccessProvider implementation="com.dzmitryj.lorelens.lock.LoreWritingAccessProvider"/>
        <statusBarWidgetFactory id="LoreLensStatusBarWidget"
                                implementation="com.dzmitryj.lorelens.ui.LoreStatusBarWidgetFactory"/>
        <checkoutProvider implementation="com.dzmitryj.lorelens.update.LoreCheckoutProvider"/>
        <ignoredFileContentProvider implementation="com.dzmitryj.lorelens.ignore.LoreIgnoredFileContentProvider"/>
        <fileType name="LoreIgnore file" language="LoreIgnore" fileNames=".loreignore" fieldName="INSTANCE"
                  implementationClass="com.dzmitryj.lorelens.ignore.LoreIgnoreFileType"/>
        <lang.parserDefinition language="LoreIgnore"
                               implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreParserDefinition"/>
        <lang.braceMatcher language="LoreIgnore"
                           implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreBraceMatcher"/>
        <lang.commenter language="LoreIgnore"
                        implementationClass="com.intellij.openapi.vcs.changes.ignore.lang.IgnoreCommenter"/>
        <codeInsight.lineMarkerProvider language="LoreIgnore"
                                        implementationClass="com.intellij.openapi.vcs.changes.ignore.codeInsight.IgnoreDirectoryMarkerProvider"/>
        <changesViewContent id="LoreLensLog" tabName="LoreLens"
                            className="com.dzmitryj.lorelens.ui.LoreLogTab"
                            predicateClassName="com.dzmitryj.lorelens.ui.LoreLogTabVisibility"/>
    </extensions>

    <actions>
        <action id="LoreLens.FullRescan" class="com.dzmitryj.lorelens.dirty.LoreFullRescanAction">
            <add-to-group group-id="Vcs.Operations.Popup.VcsAware" anchor="last"/>
        </action>
        <action id="LoreLens.CreateRepository" class="com.dzmitryj.lorelens.update.LoreCreateRepositoryAction">
            <add-to-group group-id="Vcs.Import" anchor="last"/>
        </action>
        <action id="ChangesView.Shelve" overrides="true" class="com.dzmitryj.lorelens.shelf.LoreAwareShelveAction"
                icon="com.intellij.platform.vcs.impl.icons.PlatformVcsImplIcons.Shelve"/>

        <group id="LoreLens.Conflicts" popup="false">
            <action id="LoreLens.MarkResolved" class="com.dzmitryj.lorelens.merge.LoreMarkResolvedAction"/>
            <action id="LoreLens.ResolveMine" class="com.dzmitryj.lorelens.merge.LoreResolveMineAction"/>
            <action id="LoreLens.ResolveTheirs" class="com.dzmitryj.lorelens.merge.LoreResolveTheirsAction"/>
            <action id="LoreLens.Unresolve" class="com.dzmitryj.lorelens.merge.LoreUnresolveAction"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </group>
        <action id="LoreLens.AbortMerge" class="com.dzmitryj.lorelens.merge.LoreAbortMergeAction">
            <add-to-group group-id="Vcs.Operations.Popup.VcsAware" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
